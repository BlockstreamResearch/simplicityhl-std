/*
 * Confidential Transactions: commitment builders and openings.
 *
 *     H_a = hash_to_curve(asset_id) + abf*G     (asset generator)
 *     C   = v*H_a + vbf*G                       (value commitment)
 *
 * Every assert in this module takes blinding factors, which means the value or
 * asset id it checks becomes PUBLIC to anyone reading the witness.
 * For checks that constrain commitments while keeping the values sealed, use
 * `crate::lib::ct::relations`.
 */

use crate::lib::asserts::{assert_eq_64, assert_eq_256};
use crate::lib::ct::point::conf_point_to_ge;
use crate::lib::u64::convert::u64_to_u256;

/// Returns true iff `p` has the same x-coordinate as `expected`, i.e. `p == +/-expected`.
/// Only use on points from the transaction, where consensus rules out the negation;
/// a `Point` from the witness could be either sign.
pub fn is_x_eq(p: Point, expected: Gej) -> bool {
    let (_, x): (u1, u256) = p;
    jet::gej_x_equiv(x, expected)
}

/// Asserts that `p` has the same x-coordinate as `expected`; see `is_x_eq`.
pub fn assert_x_eq(p: Point, expected: Gej) {
    assert!(is_x_eq(p, expected));
}

/// Builds the asset generator `H_a = hash_to_curve(asset_id) + abf*G`.
pub fn asset_generator(asset_id: u256, abf: Scalar) -> Gej {
    jet::gej_ge_add(jet::generate(abf), jet::hash_to_curve(asset_id))
}

/// Builds the value commitment `C = v*asset_gen + vbf*G`.
pub fn value_commitment(v: u64, asset_gen: Gej, vbf: Scalar) -> Gej {
    jet::linear_combination_1((u64_to_u256(v), asset_gen), vbf)
}

/// Asserts that the asset generator `h` is `hash_to_curve(asset_id) + abf*G`.
pub fn assert_asset_generator(h: Point, asset_id: u256, abf: Scalar) {
    assert_x_eq(h, asset_generator(asset_id, abf));
}

/// Asserts that the value commitment `c` is `v*asset_gen + vbf*G`.
pub fn assert_value_commitment(c: Point, v: u64, asset_gen: Gej, vbf: Scalar) {
    assert_x_eq(c, value_commitment(v, asset_gen, vbf));
}

/// Asserts that `c` decodes to exactly `v*h + vbf*G`.
fn verify_value_commitment(c: Point, v: u64, h: Ge, vbf: Scalar) {
    jet::linear_verify_1(((u64_to_u256(v), h), vbf), conf_point_to_ge(c));
}

/// Asserts that an `(asset, amount)` pair opens to `expected_asset_id` and
/// `expected_amount`.
///
/// A confidential amount is checked by decoding its points and verifying them
/// exactly with `jet::linear_verify_1`. Compared with rebuilding them and
/// comparing x-coordinates, this costs less but makes a larger program (see
/// `simf/bench/ct/opening.simf`). It relies on `conf_point_to_ge` decoding the
/// points correctly.
pub fn assert_opens_to(
    asset: Asset1,
    amount: Amount1,
    expected_asset_id: u256,
    expected_amount: u64,
    abf: Scalar,
    vbf: Scalar
) {
    match asset {
        Left(conf_asset: Point) => {
            match amount {
                Left(conf_amount: Point) => {
                    // `h == H_0 + abf*G`, so `h` is the generator `c` commits against.
                    let h: Ge = conf_point_to_ge(conf_asset);
                    jet::linear_verify_1(((1, jet::hash_to_curve(expected_asset_id)), abf), h);
                    verify_value_commitment(conf_amount, expected_amount, h, vbf);
                },
                Right(explicit_amount: u64) => {
                    assert_asset_generator(conf_asset, expected_asset_id, abf);
                    assert_eq_64(explicit_amount, expected_amount);
                },
            };
        },
        Right(explicit_asset: u256) => {
            assert_eq_256(explicit_asset, expected_asset_id);

            match amount {
                // An explicit asset commits against the unblinded generator.
                Left(conf_amount: Point) => {
                    verify_value_commitment(
                        conf_amount,
                        expected_amount,
                        jet::hash_to_curve(expected_asset_id),
                        vbf
                    );
                },
                Right(explicit_amount: u64) => assert_eq_64(explicit_amount, expected_amount),
            };
        },
    };
}
