use crate::lib::utxo::getters::asset_id::{
    get_explicit_asset_id,
    get_confidential_asset_id,
    get_explicit_input_asset_id,
    get_confidential_input_asset_id,
    get_explicit_output_asset_id,
    get_confidential_output_asset_id,
    get_explicit_current_asset_id,
    get_confidential_current_asset_id
};
use crate::lib::asserts::{assert_eq_1, assert_eq_256};

/// Asserts that the explicit asset_id at the specified input or output equals the expected u256 value
/// 
/// Warning: using this incurs the overhead, and should be used only when the input/output selection
/// needs to be determined at runtime; otherwise, use the input- or output- specific getter directly.
pub fn assert_explicit_asset_id(index: u32, is_input_index: bool, expected: u256) {
    let asset_id: u256 = get_explicit_asset_id(index, is_input_index);

    assert_eq_256(asset_id, expected);
}

/// Asserts that the confidential asset_id at the specified input or output equals the expected Confidential1 value
/// 
/// Warning: using this incurs the overhead, and should be used only when the input/output selection
/// needs to be determined at runtime; otherwise, use the input- or output- specific getter directly.
pub fn assert_confidential_asset_id(index: u32, is_input_index: bool, expected: Confidential1) {
    let (parity_bit, asset_id): Confidential1 = get_confidential_asset_id(index, is_input_index);
    let (expected_parity_bit, expected_asset_id): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(asset_id, expected_asset_id);
}

/// Asserts that the explicit asset_id at the specified input equals the expected u256 value
pub fn assert_explicit_input_asset_id(index: u32, expected: u256) {
    let asset_id: u256 = get_explicit_input_asset_id(index);

    assert_eq_256(asset_id, expected);
}

/// Asserts that the confidential asset_id at the specified input equals the expected Confidential1 value
pub fn assert_confidential_input_asset_id(index: u32, expected: Confidential1) {
    let (parity_bit, asset_id): Confidential1 = get_confidential_input_asset_id(index);
    let (expected_parity_bit, expected_asset_id): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(asset_id, expected_asset_id);
}

/// Asserts that the explicit asset_id at the specified output equals the expected u256 value
pub fn assert_explicit_output_asset_id(index: u32, expected: u256) {
    let asset_id: u256 = get_explicit_output_asset_id(index);

    assert_eq_256(asset_id, expected);
}

/// Asserts that the confidential asset_id at the specified output equals the expected Confidential1 value
pub fn assert_confidential_output_asset_id(index: u32, expected: Confidential1) {
    let (parity_bit, asset_id): Confidential1 = get_confidential_output_asset_id(index);
    let (expected_parity_bit, expected_asset_id): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(asset_id, expected_asset_id);
}

/// Asserts that the explicit input asset_id at the current_index equals the expected u256 value
pub fn assert_explicit_current_asset_id(expected: u256) {
    let asset_id: u256 = get_explicit_current_asset_id();

    assert_eq_256(asset_id, expected);
}

/// Asserts that the confidential input asset_id at the current_index equals the expected Confidential1 value
pub fn assert_confidential_current_asset_id(expected: Confidential1) {
    let (parity_bit, asset_id): Confidential1 = get_confidential_current_asset_id();
    let (expected_parity_bit, expected_asset_id): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(asset_id, expected_asset_id);
}
