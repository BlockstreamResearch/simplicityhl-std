use crate::lib::utxo::getters::amount::{
    get_explicit_amount,
    get_confidential_amount,
    get_explicit_input_amount,
    get_confidential_input_amount,
    get_explicit_output_amount,
    get_confidential_output_amount,
    get_explicit_current_amount,
    get_confidential_current_amount
};
use crate::lib::asserts::{assert_eq_1, assert_eq_64, assert_eq_256};

/// Asserts that the explicit amount at the specified input or output equals the expected u64 value
/// 
/// Warning: using this incurs the overhead, and should be used only when the input/output selection
/// needs to be determined at runtime; otherwise, use the input- or output- specific getter directly.
pub fn assert_explicit_amount(index: u32, is_input_index: bool, expected: u64) {
    let amount: u64 = get_explicit_amount(index, is_input_index);

    assert_eq_64(amount, expected);
}

/// Asserts that the confidential amount at the specified input or output equals the expected Confidential1 value
/// 
/// Warning: using this incurs the overhead, and should be used only when the input/output selection
/// needs to be determined at runtime; otherwise, use the input- or output- specific getter directly.
pub fn assert_confidential_amount(index: u32, is_input_index: bool, expected: Confidential1) {
    let (parity_bit, amount): Confidential1 = get_confidential_amount(index, is_input_index);
    let (expected_parity_bit, expected_amount): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(amount, expected_amount);
}

/// Asserts that the explicit amount at the specified input equals the expected u64 value
pub fn assert_explicit_input_amount(index: u32, expected: u64) {
    let amount: u64 = get_explicit_input_amount(index);

    assert_eq_64(amount, expected);
}

/// Asserts that the confidential amount at the specified input equals the expected Confidential1 value
pub fn assert_confidential_input_amount(index: u32, expected: Confidential1) {
    let (parity_bit, amount): Confidential1 = get_confidential_input_amount(index);
    let (expected_parity_bit, expected_amount): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(amount, expected_amount);
}

/// Asserts that the explicit amount at the specified output equals the expected u64 value
pub fn assert_explicit_output_amount(index: u32, expected: u64) {
    let amount: u64 = get_explicit_output_amount(index);

    assert_eq_64(amount, expected);
}

/// Asserts that the confidential amount at the specified output equals the expected Confidential1 value
pub fn assert_confidential_output_amount(index: u32, expected: Confidential1) {
    let (parity_bit, amount): Confidential1 = get_confidential_output_amount(index);
    let (expected_parity_bit, expected_amount): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(amount, expected_amount);
}

/// Asserts that the explicit input amount at the current_index equals the expected u64 value
pub fn assert_explicit_current_amount(expected: u64) {
    let amount: u64 = get_explicit_current_amount();

    assert_eq_64(amount, expected);
}

/// Asserts that the confidential input amount at the current_index equals the expected Confidential1 value
pub fn assert_confidential_current_amount(expected: Confidential1) {
    let (parity_bit, amount): Confidential1 = get_confidential_current_amount();
    let (expected_parity_bit, expected_amount): Confidential1 = expected;

    assert_eq_1(parity_bit, expected_parity_bit);
    assert_eq_256(amount, expected_amount);
}
