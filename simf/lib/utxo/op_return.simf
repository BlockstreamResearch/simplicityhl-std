pub type Entry = Either<(u2, u256), Either<u1, u4>>;

/// Returns specified entry at the specified OP_RETURN output and entry index.
/// Returns `None` if the output doesn't exist, isn't null data, or has no such entry.
pub fn get_entry_option(output_index: u32, entry_index: u32) -> Option<Entry> {
    match jet::output_null_datum(output_index, entry_index) {
        Some(entry_option: Option<Entry>) => entry_option,
        None => None,
    }
}

/// Returns `(x, hash)` from the specified entry if it is pushed data and `None` otherwise.
/// 
/// `hash` is the SHA256 hash of the pushed data and `x` indicates how the data was pushed:
/// 
/// 0 is an immediate 0 to 75 bytes, 1 is an OP_PUSHDATA1,
/// 2 is an OP_PUSHDATA2 and 3 is an OP_PUSHDATA4.
pub fn pushed_data_from_entry(entry: Entry) -> Option<(u2, u256)> {
    match entry {
        Left(pushed_data: (u2, u256)) => Some(pushed_data),
        Right(_other: Either<u1, u4>) => None,
    }
}

/// Returns `(x, hash)` if the the entry at entry_index of the specified output is pushed data.
/// 
/// `hash` is the SHA256 hash of the pushed data and `x` indicates how the data was pushed:
/// 
/// 0 is an immediate 0 to 75 bytes, 1 is an OP_PUSHDATA1,
/// 2 is an OP_PUSHDATA2 and 3 is an OP_PUSHDATA4.
pub fn get_pushed_data(output_index: u32, entry_index: u32) -> Option<(u2, u256)> {
    let entry: Option<Entry> = get_entry_option(output_index, entry_index);

    match entry {
        Some(entry: Entry) => pushed_data_from_entry(entry),
        None => None,
    }
}

/// Returns `x - 1` from the specified entry if it is `OP_x` for x in the range 1..=16 and `None` otherwise
pub fn op_x_minus_1_from_entry(entry: Entry) -> Option<u4> {
    match entry {
        Left(_pushed_data: (u2, u256)) => None,
        Right(right: Either<u1, u4>) => match right {
            Left(_negate_or_reserved: u1) => None,
            Right(op_x_minus_1: u4) => Some(op_x_minus_1),
        },
    }
}

/// Returns `x - 1` if the specified entry at the specified output is `OP_x` for x in the range 1..=16 and `None` otherwise
pub fn get_op_x_minus_1(output_index: u32, entry_index: u32) -> Option<u4> {
    let entry: Option<Entry> = get_entry_option(output_index, entry_index);

    match entry {
        Some(entry: Entry) => op_x_minus_1_from_entry(entry),
        None => None,
    }
}

/// Returns Some(0) if the specified entry is OP_1NEGATE, Some(1) if the entry is OP_RESERVED and `None` otherwise
pub fn negate_or_reserved_from_entry(entry: Entry) -> Option<u1> {
    match entry {
        Left(_pushed_data: (u2, u256)) => None,
        Right(right: Either<u1, u4>) => match right {
            Left(negate_or_reserved: u1) => Some(negate_or_reserved),
            Right(_op_x_minus_1: u4) => None,
        },
    }
}

/// Returns Some(0) if the the entry at entry_index of the specified output is OP_1NEGATE,
/// Some(1) if the entry is OP_RESERVED and `None` otherwise
pub fn get_negate_or_reserved(output_index: u32, entry_index: u32) -> Option<u1> {
    let entry: Option<Entry> = get_entry_option(output_index, entry_index);

    match entry {
        Some(entry: Entry) => negate_or_reserved_from_entry(entry),
        None => None,
    }
}

/// Returns the kind of the entry.
/// 0 is pushed data, 1 is OP_1..OP_16 and 2 is OP_1NEGATE or OP_RESERVED
pub fn kind_of_entry(entry: Entry) -> u8 {
    match entry {
        Left(_pushed_data: (u2, u256)) => 0,
        Right(right_branch: Either<u1, u4>) => match right_branch {
            Left(_negate_or_reserved: u1) => 2,
            Right(_op_x_minus_1: u4) => 1,
        },
    }
}

/// Returns true if the specified output is an OP_RETURN (null data) output.
pub fn is_output_op_return(output_index: u32) -> bool {
    match jet::output_null_datum(output_index, 0) {
        Some(_entry_option: Option<Entry>) => true,
        None => false,
    }
}

/// Returns true if the specified output is an OP_RETURN output that has an entry at entry_index
pub fn has_entry(output_index: u32, entry_index: u32) -> bool {
    match get_entry_option(output_index, entry_index) {
        Some(_entry: Entry) => true,
        None => false,
    }
}

/// Asserts that the specified output is an OP_RETURN (null data) output
pub fn assert_output_is_op_return(output_index: u32) {
    assert!(is_output_op_return(output_index));
}

/// Asserts that the specified output is an OP_RETURN output that has an entry at entry_index
pub fn assert_has_entry(output_index: u32, entry_index: u32) {
    assert!(has_entry(output_index, entry_index));
}
