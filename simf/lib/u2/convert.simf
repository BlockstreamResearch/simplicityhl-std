/// Widening uint conversions

/// Converts u2 to u8
pub fn u2_to_u8(a: u2) -> u8 {
    <(u2, u2, u2, u2)>::into((0, 0, 0, a))
}

/// Converts u2 to u16
pub fn u2_to_u16(a: u2) -> u16 {
    let a_u8: u8 = u2_to_u8(a);

    jet::left_pad_low_8_16(a_u8)
}

/// Converts u2 to u32
pub fn u2_to_u32(a: u2) -> u32 {
    let a_u8: u8 = u2_to_u8(a);

    jet::left_pad_low_8_32(a_u8)
}

/// Converts u2 to u64
pub fn u2_to_u64(a: u2) -> u64 {
    let a_u8: u8 = u2_to_u8(a);

    jet::left_pad_low_8_64(a_u8)
}

/// Converts u2 to u128
pub fn u2_to_u128(a: u2) -> u128 {
    let a_u64: u64 = u2_to_u64(a);

    <(u64, u64)>::into((0, a_u64))
}

/// Converts u2 to u256
pub fn u2_to_u256(a: u2) -> u256 {
    let a_u128: u128 = u2_to_u128(a);

    <(u128, u128)>::into((0, a_u128))
}

/// Splitting uint conversions

/// Splits u2 into two u1
pub fn split_u2_into_u1(a: u2) -> (u1, u1) {
    <u2>::into(a)
}

/// Narrowing uint conversions

/// Converts u2 into u1.
/// Panics if the value does not fit in u1
pub fn safe_u2_to_u1(a: u2) -> u1 {
    let (high, low): (u1, u1) = <u2>::into(a);

    assert!(jet::eq_1(high, 0));

    low
}
