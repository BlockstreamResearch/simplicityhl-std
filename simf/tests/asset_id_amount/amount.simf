use crate::lib::asset_id_amount::amount::{
    get_explicit_amount,
    get_confidential_amount,
    get_explicit_input_amount,
    get_confidential_input_amount,
    get_explicit_output_amount,
    get_confidential_output_amount,
    get_current_explicit_amount,
    get_current_confidential_amount
};
use crate::lib::u64::convert::{safe_u64_to_u1, u64_to_u256};
use crate::lib::asserts::{assert_eq_1, assert_eq_64, assert_eq_256};

use crate::tests::support::dispatch::is_selected;

fn main() {
    let fn_idx: u8 = witness::FUNCTION_INDEX;

    let index: u32 = witness::INDEX;
    let is_input_index: bool = witness::IS_INPUT_INDEX;

    let expected_amount: u64 = witness::EXPECTED;
    let expected_confidential_amount: u256 = witness::SECOND_EXPECTED;

    match is_selected(0, fn_idx) {
        true => {
            assert_eq_64(get_explicit_amount(index, is_input_index), expected_amount);
        },
        false => (),
    };

    match is_selected(1, fn_idx) {
        true => {
            let (
                parity_bit,
                confidential_amount
            ): Confidential1 = get_confidential_amount(index, is_input_index);

            assert_eq_1(parity_bit, safe_u64_to_u1(expected_amount));
            assert_eq_256(confidential_amount, expected_confidential_amount);
        },
        false => (),
    };

    match is_selected(2, fn_idx) {
        true => {
            assert_eq_64(get_explicit_input_amount(index), expected_amount);
        },
        false => (),
    };

    match is_selected(3, fn_idx) {
        true => {
            let (
                parity_bit,
                confidential_amount
            ): Confidential1 = get_confidential_input_amount(index);

            assert_eq_1(parity_bit, safe_u64_to_u1(expected_amount));
            assert_eq_256(confidential_amount, expected_confidential_amount);
        },
        false => (),
    };

    match is_selected(4, fn_idx) {
        true => {
            assert_eq_64(get_explicit_output_amount(index), expected_amount);
        },
        false => (),
    };

    match is_selected(5, fn_idx) {
        true => {
            let (
                parity_bit,
                confidential_amount
            ): Confidential1 = get_confidential_output_amount(index);

            assert_eq_1(parity_bit, safe_u64_to_u1(expected_amount));
            assert_eq_256(confidential_amount, expected_confidential_amount);
        },
        false => (),
    };

    match is_selected(6, fn_idx) {
        true => {
            assert_eq_64(get_current_explicit_amount(), expected_amount);
        },
        false => (),
    };

    match is_selected(7, fn_idx) {
        true => {
            let (
                parity_bit,
                confidential_amount
            ): Confidential1 = get_current_confidential_amount();

            assert_eq_1(parity_bit, safe_u64_to_u1(expected_amount));
            assert_eq_256(confidential_amount, expected_confidential_amount);
        },
        false => (),
    };
}
