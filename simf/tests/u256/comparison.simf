use crate::lib::u256::comparison::{is_zero_256, lt_256, le_256};
use crate::tests::support::dispatch::is_selected;
use crate::tests::support::expect::assert_bool;

fn main() {
    let fn_idx: u8 = witness::FUNCTION_INDEX;

    let a: u256 = witness::FIRST_ARG;
    let b: u256 = witness::SECOND_ARG;
    let expected_bool: bool = witness::EXPECTED_BOOL;

    /// Comparison operations

    match is_selected(0, fn_idx) {
        true => {
            assert_bool(is_zero_256(a), expected_bool);
        },
        false => (),
    };
    match is_selected(1, fn_idx) {
        true => {
            assert_bool(lt_256(a, b), expected_bool);
        },
        false => (),
    };
    match is_selected(2, fn_idx) {
        true => {
            assert_bool(le_256(a, b), expected_bool);
        },
        false => (),
    };
}
