use crate::lib::utxo::asserts::asset_id::{
    assert_explicit_asset_id,
    assert_confidential_asset_id,
    assert_explicit_input_asset_id,
    assert_confidential_input_asset_id,
    assert_explicit_output_asset_id,
    assert_confidential_output_asset_id,
    assert_explicit_current_asset_id,
    assert_confidential_current_asset_id
};

use crate::tests::support::dispatch::is_selected;

fn main() {
    let fn_idx: u8 = witness::FUNCTION_INDEX;

    let index: u32 = witness::INDEX;
    let is_input_index: bool = witness::IS_INPUT_INDEX;

    let expected_asset_id: u256 = witness::EXPECTED;
    let expected_parity: u1 = witness::EXPECTED_PARITY;
    let expected_confidential_asset_id: u256 = witness::EXPECTED_CONF;

    let expected_confidential: Confidential1 = (expected_parity, expected_confidential_asset_id);

    match is_selected(0, fn_idx) {
        true => {
            assert_explicit_asset_id(index, is_input_index, expected_asset_id);
        },
        false => (),
    };

    match is_selected(1, fn_idx) {
        true => {
            assert_confidential_asset_id(index, is_input_index, expected_confidential);
        },
        false => (),
    };

    match is_selected(2, fn_idx) {
        true => {
            assert_explicit_input_asset_id(index, expected_asset_id);
        },
        false => (),
    };

    match is_selected(3, fn_idx) {
        true => {
            assert_confidential_input_asset_id(index, expected_confidential);
        },
        false => (),
    };

    match is_selected(4, fn_idx) {
        true => {
            assert_explicit_output_asset_id(index, expected_asset_id);
        },
        false => (),
    };

    match is_selected(5, fn_idx) {
        true => {
            assert_confidential_output_asset_id(index, expected_confidential);
        },
        false => (),
    };

    match is_selected(6, fn_idx) {
        true => {
            assert_explicit_current_asset_id(expected_asset_id);
        },
        false => (),
    };

    match is_selected(7, fn_idx) {
        true => {
            assert_confidential_current_asset_id(expected_confidential);
        },
        false => (),
    };
}
