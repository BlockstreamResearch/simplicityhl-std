use crate::lib::u256::{is_zero_256, lt_256, le_256};
use crate::helper::{if_test_this_function, assert_bool};

fn main() {
    let fn_idx: u8 = witness::FUNCTION_INDEX;

    let a: u256 = witness::FIRST_ARG;
    let b: u256 = witness::SECOND_ARG;
    let expected_bool: bool = witness::EXPECTED_BOOL;

    /// Arithmetic

    match if_test_this_function(0, fn_idx) { true => { assert_bool(is_zero_256(a), expected_bool); }, false => {}, };
    match if_test_this_function(1, fn_idx) { true => { assert_bool(lt_256(a, b), expected_bool); }, false => {}, };
    match if_test_this_function(2, fn_idx) { true => { assert_bool(le_256(a, b), expected_bool); }, false => {}, };
}
