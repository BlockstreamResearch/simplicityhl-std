use crate::lib::u64::mul_div::mul_div_64;

use crate::lib::asserts::assert_eq_64;
use crate::helper::if_test_this_function;

fn main() {
    let fn_idx: u8 = witness::FUNCTION_INDEX;

    let a: u64 = witness::FIRST_ARG;
    let b: u64 = witness::SECOND_ARG;
    let c: u64 = witness::THIRD_ARG;

    let expected: Option<u64> = witness::EXPECTED;

    match if_test_this_function(0, fn_idx) {
        true => {
            assert_eq_64(mul_div_64(a, b, c), unwrap(expected));
        },
        false => (),
    };
}
